# URide v1.0 MVP Pilot — example only. Do not commit real secrets.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/uride
REDIS_URL=redis://HOST:6379
JWT_ACCESS_SECRET=replace_with_32_plus_random_characters
CORS_ORIGINS=https://admin.your-uride-domain.example

ROUTING_BASE_URL=https://your-production-routing-provider.example

STRIPE_SECRET_KEY=replace_with_stripe_test_or_live_secret
STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_REQUIRE_CONNECT=true
STRIPE_CONNECT_REFRESH_URL=https://your-uride-domain.example/connect/refresh
STRIPE_CONNECT_RETURN_URL=https://your-uride-domain.example/connect/return
URIDE_COMMISSION_RATE=0.20

ENABLE_DISPATCH_WORKER=true
DISPATCH_WORKER_INTERVAL_MS=5000
ENABLE_NOTIFICATION_WORKER=true

EXPO_ACCESS_TOKEN=
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=55
RISK_CRITICAL_THRESHOLD=80
AI_PROVIDER_MODE=FOUNDATION_RULES
AI_ALLOW_EXTERNAL_PROVIDER=false
