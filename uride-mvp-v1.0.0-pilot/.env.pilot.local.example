# Local-only pilot bootstrap. Copy to .env and replace all passwords/secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://uride:uride_dev@localhost:5432/uride
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters_123456
CORS_ORIGINS=http://localhost:5173

# Local routing smoke provider. Replace before external/public pilot.
ROUTING_BASE_URL=https://router.project-osrm.org

# Stripe can remain unset for the first ride until the payment step.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REQUIRE_CONNECT=false
URIDE_COMMISSION_RATE=0.20

ENABLE_DISPATCH_WORKER=true
DISPATCH_WORKER_INTERVAL_MS=5000
ENABLE_NOTIFICATION_WORKER=false

PILOT_PASSENGER_EMAIL=passenger.pilot@uride.local
PILOT_PASSENGER_PASSWORD=replace_passenger_password
PILOT_DRIVER_EMAIL=driver.pilot@uride.local
PILOT_DRIVER_PASSWORD=replace_driver_password
PILOT_ADMIN_EMAIL=admin.pilot@uride.local
PILOT_ADMIN_PASSWORD=replace_admin_password
