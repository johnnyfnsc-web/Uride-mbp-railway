NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://uride:uride_dev@localhost:5432/uride
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=change_me_too
# Development routing provider. Public OSRM is suitable only for development/testing.
ROUTING_BASE_URL=https://your-production-routing-provider.example

# Push notifications / workers
EXPO_ACCESS_TOKEN=
ENABLE_DISPATCH_WORKER=true
DISPATCH_WORKER_INTERVAL_MS=5000
ENABLE_NOTIFICATION_WORKER=true

# Stripe payments / Connect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
URIDE_COMMISSION_RATE=0.20
STRIPE_REQUIRE_CONNECT=false
STRIPE_CONNECT_REFRESH_URL=https://example.com/uride/connect/refresh
STRIPE_CONNECT_RETURN_URL=https://example.com/uride/connect/return

# Fraud & Risk
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=55
RISK_CRITICAL_THRESHOLD=80

# URide AI
AI_PROVIDER_MODE=FOUNDATION_RULES
AI_ALLOW_EXTERNAL_PROVIDER=false
