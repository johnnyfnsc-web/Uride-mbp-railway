name: Unzip project

on:
  workflow_dispatch:
  push:

permissions:
  contents: write

jobs:
  unzip:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Unzip project
        run: |
          unzip -q "*.zip" -d extracted
          cp -R extracted/*/* . 2>/dev/null || cp -R extracted/* .
          rm -rf extracted
          rm -f *.zip

      - name: Commit extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract URide project" || echo "No changes to commit"
          git push
